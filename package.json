{
  "name": "codequest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CodeQuest: bite-size coding lessons. Android app and Windows desktop app.",
  "main": "electron/main.cjs",
  "author": "taylarabraham-bit",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 5181",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:desktop": "tsc -p tsconfig.json --noEmit && vite build --mode desktop --outDir dist-desktop",
    "app": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win portable --x64 --publish never",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "io.github.taylarabraham-bit.codequest",
    "productName": "CodeQuest Desktop",
    "copyright": "Personal project",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "CodeQuest-Desktop-${version}.exe"
    }
  }
}
